# stash-llm — litellm.env template (KEY NAMES ONLY, no values).
# Copy to `litellm.env` next to docker-compose.nas.yml and fill in. Git-ignored.
#
# These are the ONLY place provider secrets live. The litellm container reads them;
# stash never sees them.

# Gateway auth: stash-llm authenticates to litellm with this key
# (must equal STASH_ASSISTANT_API_KEY in stash.env). Generate a random string.
LITELLM_MASTER_KEY=

# MiniMax (https://platform.minimax.io) — the headless default provider
MINIMAX_API_KEY=

# xAI / Grok (https://console.x.ai) — for the `grok` model. First-party API key,
# OpenAI-compatible; no OAuth bridge needed.
XAI_API_KEY=
