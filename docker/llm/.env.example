# stash-llm — stash.env template (KEY NAMES ONLY, no values).
# Copy to `stash.env` next to docker-compose.nas.yml and fill in. Git-ignored.
#
# The assistant talks to the litellm gateway over the private Docker network, so
# the stash container holds NO provider secrets — only the gateway URL/key/model.

# OpenAI-compatible gateway (litellm). BASE_URL + MODEL are also set in the compose
# file; set them here to override.
STASH_ASSISTANT_BASE_URL=        # e.g. http://litellm:4000/v1
STASH_ASSISTANT_API_KEY=         # the litellm master key (must match LITELLM_MASTER_KEY)
STASH_ASSISTANT_MODEL=           # minimax | claude

# Assistant behaviour (optional — have defaults)
STASH_ASSISTANT_ENABLED=
STASH_ASSISTANT_WRITE_POLICY=    # ask | auto | readonly
STASH_ASSISTANT_DEV_LOOP_ENABLED= # Phase 2 gate; leave empty/false in production
