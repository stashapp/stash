# stash-llm — environment template (KEY NAMES ONLY, no values).
# Copy to `stash.env` next to docker-compose.nas.yml and fill from your own secret store.
# The real stash.env is git-ignored — never commit secrets.

# Anthropic / Claude (required for the assistant)
STASH_ANTHROPIC_API_KEY=

# Assistant behaviour (optional — these have defaults in config)
STASH_ASSISTANT_MODEL=
STASH_ASSISTANT_ENABLED=
STASH_ASSISTANT_WRITE_POLICY=        # ask | auto | readonly
STASH_ASSISTANT_DEV_LOOP_ENABLED=    # Phase 2 gate; leave empty/false in production
